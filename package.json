{
  "name": "dnd-tree-sortable",
  "version": "1.0.3",
  "private": false,
  "description": "React sortable tree component",
  "keywords": [
    "dnd",
    "dnd-kit",
    "drag",
    "drag-and-drop",
    "draggable",
    "droppable",
    "react",
    "react-tree",
    "react-tree-sortable",
    "sortable",
    "tree",
    "tree-sortable",
    "virtuoso"
  ],
  "homepage": "https://ductinhkzz.github.io/dnd-tree-sortable/",
  "license": "MIT",
  "author": "Ghost Alpha",
  "repository": {
    "type": "git",
    "url": "https://github.com/ductinhkzz/dnd-tree-sortable"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/assets/style.css": "./dist/assets/style.css"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && vite build",
    "lint": "oxlint --deny-warnings && node scripts/check-file-names.mjs",
    "dev": "vite serve docs",
    "build-docs": "npm run registry:build && tsc -p docs/tsconfig.app.json && vite build docs",
    "ssr-docs": "npm run build-docs && vite preview docs",
    "format": "oxfmt --write .",
    "prepare": "husky",
    "registry:build": "shadcn build --output docs/public/r",
    "typecheck": "tsc -p tsconfig.json && tsc -p docs/tsconfig.app.json",
    "test": "vitest run",
    "predev": "npm run registry:build",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check .",
    "test:watch": "vitest",
    "commitlint": "commitlint",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build-docs && npm test && npm run build",
    "pretest": "npm run registry:build",
    "pretest:watch": "npm run registry:build",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/collision": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "clsx": "^2.1.1",
    "react-virtuoso": "^4.18.16"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
